# 应用配置
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# 数据库配置
MONGODB_URI=mongodb://localhost:27017/creative-ideas
ELASTICSEARCH_URL=http://localhost:9200

# Redis配置
REDIS_URL=redis://localhost:6379

# RabbitMQ配置
RABBITMQ_URL=amqp://localhost:5672

# LLM配置
OPENAI_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# 爬虫配置
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; CreativeIdeasBot/1.0; +https://example.com/bot)
CRAWLER_CONCURRENCY=5
CRAWLER_DELAY=1000

# 安全配置
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# 日志配置
LOG_LEVEL=info

