# API配置
PORT=3000
NODE_ENV=development

# OpenAI API配置
OPENAI_API_KEY=your_openai_api_key

# MongoDB配置
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=creative_ideas

# Elasticsearch配置
ELASTICSEARCH_URI=http://localhost:9200

# 爬虫配置
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; CreativeIdeasBot/1.0; +https://example.com/bot)
CRAWLER_TIMEOUT=30000
CRAWLER_INTERVAL_MINUTES=60
CRAWLER_TARGETS_PER_RUN=5

